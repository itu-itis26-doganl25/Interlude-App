# Django API prefix. The default /api uses Vite's local proxy.
VITE_API_BASE_URL=/api

# Used only by the Vite development server proxy; never exposed to the browser.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional local-only navigation preview (listener, musician, admin). Never authentication.
# VITE_DEV_PREVIEW_ROLE=listener
